# Copy to ~/.config/makenomistakes/secrets.env (chmod 600) or export in your shell.
# NEVER commit a filled-in copy. Values below are placeholders, not defaults.

# Hugging Face token for gated/private repos (optional). Create at https://huggingface.co/settings/tokens
HF_TOKEN=

# Civitai API key for downloads that need a login (optional). Create at https://civitai.com/user/account
CIVITAI_TOKEN=

# Where model files live (outside the repo, HF cache layout). Needs tens of GB free.
MNM_MODELS_DIR=/data/models

# Runtime state: recipe files (JSON), port assignments, the engine ledger. Outside the repo.
MNM_STATE_DIR=~/.local/state/makenomistakes

# What runs, pipelines and workflows produce, one folder per run; `mnm clean` empties it.
MNM_OUTPUTS_DIR=/data/outputs

# Where `mnm backup --auto` writes its archives, 7 daily and 4 weekly kept.
MNM_BACKUPS_DIR=/data/backups

# The web UI's port and the router's (one URL for every model).
MNM_PORT=7800
MNM_ROUTER_PORT=7801

# Where the router listens: 0.0.0.0 (every interface), local (this machine and its
# Docker containers: 127.0.0.1 plus Docker's bridge gateway), or addresses separated by
# commas. `mnm setup` asks on a native box and under WSL mirrored networking (unattended,
# it takes local); `mnm service install` applies a change.
MNM_ROUTER_HOST=0.0.0.0

# Ollama's API on a second port (optional): 11434 is the port Ollama clients assume
# (Home Assistant, n8n). Same addresses and key as the router; the router's own port serves
# /api/... as well. Leave unset when Ollama itself runs here.
MNM_OLLAMA_PORT=

# The router's key (optional). Set it and every request must send it as its API key
# (Authorization: Bearer). Required wherever 7801 is on the LAN (mirrored networking, or a
# native box with MNM_ROUTER_HOST=0.0.0.0): `mnm doctor` fails without it there.
MNM_API_KEY=

# The names the router answers to besides localhost, 127.0.0.1, host.docker.internal and its
# own addresses: a Tailscale name or a LAN DNS name, commas between. Any other Host gets
# 421 (a web page that points its own name at this machine). `mnm service install` applies it.
MNM_ROUTER_HOSTS=

# On a client install only (GUIDE 13.5): the box's router, which `mnm url`, `mnm doctor
# --from lan` and `mnm router manifest` ask (http://192.168.1.10:7801, or a Tailscale name).
# Never set it on the box itself. The client's MNM_API_KEY is the box's key.
MNM_ROUTER_URL=

# Which cards mnm uses (optional): nvidia-smi's index (0 when unset), several (0,1) or all.
# A value that is not a card number (an empty one included) is refused, never read as card 0.
# MNM_GPU=0,1

# The web UI's address for links an MCP client on another machine opens (optional),
# such as http://192.168.1.10:7800.
MNM_WEB_URL=

# Notifications when a run, a film, a download or an engine update ends (optional):
# an ntfy topic (`mnm notify --ntfy URL` saves it), its access token (read from this file
# only), and the Windows toast under WSL (on/off; empty: on under WSL, off elsewhere).
MNM_NTFY_URL=
MNM_NTFY_TOKEN=
MNM_TOAST=

# The quality tune (`mnm tune <name> --quality`): the decode speed (tok/s) the quant it
# keeps never goes under, a chat or vision instance's and a coding one's (`--floor` for one tune).
MNM_FLOOR_CHAT=15
MNM_FLOOR_AGENT=20

# Workspace apps (`mnm apps`): their data, one folder per app (LibreChat's accounts,
# chats and uploads; OpenHands' home), and the one folder of your code they see (OpenCode works
# in it, OpenHands mounts it at /projects). `mnm apps install` generates each app's own
# credential here: OpenCode's server password (user `opencode`) and OpenHands' session key.
MNM_APPS_DIR=/data/apps
MNM_PROJECTS_DIR=~/src
MNM_OPENCODE_PASSWORD=
MNM_OPENHANDS_KEY=

# The backend the engines run on: cuda12, cuda13, rocm, vulkan or cpu. Leave it empty:
# mnm decides from the cards (CUDA on NVIDIA, Vulkan on AMD and Intel, the CPU without a card)
# and refuses a backend the cards cannot run, saying why.
MNM_BACKEND=

# A Hugging Face mirror (optional; from your shell only, not this file), such as
# https://hf-mirror.com: every Hub call and download goes there; HF_TOKEN is never sent to it.
# HF_ENDPOINT=
